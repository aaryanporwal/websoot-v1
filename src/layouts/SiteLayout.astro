---
import { getCollection } from "astro:content";
import CommandSwitcher from "../../components/CommandSwitcher";
import WebMcp from "../../components/WebMcp";
import "../../styles/globals.css";
import { WORK_ENTRIES } from "../data/work";
import { buildSiteCommands } from "../lib/commands";
import { postHref, postSummary, sortPosts } from "../lib/posts";
import { buildSiteCatalog, pageFromPath, type SitePage } from "../lib/webmcp";
import PostHog from "../components/posthog.astro";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  socialImageType?: string;
  socialType?: "website" | "article";
  bodyClass?: string;
  webmcpPage?: SitePage;
};

const {
  title = "Aaryan Porwal - AI Systems & Web Engineer",
  description = "Aaryan Porwal builds software with care and curiosity: interfaces, systems, React, agents, LLMs, and RAG tools that feel good to use.",
  canonicalPath = Astro.url.pathname,
  socialImage = "/og-image.jpg",
  socialImageAlt = "Aaryan Porwal - AI Systems & Web Engineer",
  socialImageWidth = 2496,
  socialImageHeight = 1569,
  socialImageType = "image/jpeg",
  socialType = "website",
  bodyClass = "bg-body font-sans text-white antialiased",
  webmcpPage,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? "https://aaryanporwal.com");
const socialImageUrl = new URL(socialImage, Astro.site ?? "https://aaryanporwal.com");

const posts = sortPosts(
  await getCollection("blog", ({ data }) => data.draft !== true),
);

const writing = posts.map((post) => ({
  title: post.data.title,
  href: postHref(post),
  date: post.data.date.toISOString(),
  tags: post.data.tags,
  summary: postSummary(post),
}));
const commands = buildSiteCommands(writing);
const catalog = buildSiteCatalog({
  destinations: commands,
  writing,
  work: WORK_ENTRIES.map((project) => ({
    title: project.title,
    tag: project.tag,
    description: project.desc,
    href: project.href,
  })),
  page: webmcpPage ?? pageFromPath(canonicalPath),
});
const originTrialToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#08080B" />

    <meta property="og:type" content={socialType} />
    <meta property="og:site_name" content="Aaryan Porwal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aaryan7476" />
    <meta name="twitter:creator" content="@aaryan7476" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link
      rel="icon"
      href="/favicon-dark.svg?v=2"
      type="image/svg+xml"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/favicon-light.svg?v=2"
      type="image/svg+xml"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/favicon-dark.png?v=2"
      type="image/png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      href="/favicon-light.png?v=2"
      type="image/png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/clash-display-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const fallback = "default";
        const themes = new Set([
          "default",
          "light",
          "gruvbox",
          "everforest",
          "nature",
          "rose-pine",
        ]);
        const saved = localStorage.getItem("aaryanporwal-theme");
        const theme = saved === "dark" ? fallback : themes.has(saved) ? saved : fallback;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      originTrialToken ? (
        <meta http-equiv="origin-trial" content={originTrialToken} />
      ) : null
    }
    <PostHog />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest("[data-command-switcher-trigger]")) return;

        window.dispatchEvent(new CustomEvent("command-switcher:open"));
      });
    </script>
    <CommandSwitcher client:idle commands={commands} />
    <WebMcp client:idle catalog={catalog} />
  </body>
</html>
