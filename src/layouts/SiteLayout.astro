---
import { getCollection } from "astro:content";
import CommandSwitcher, {
  type CommandItem,
} from "../../components/CommandSwitcher";
import "../../styles/globals.css";
import { postHref, postSummary, sortPosts } from "../lib/posts";
import PostHog from "../components/posthog.astro";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialType?: "website" | "article";
  bodyClass?: string;
};

const {
  title = "Aaryan Porwal · AI Systems & Web Engineer",
  description = "Aaryan Porwal builds software with care and curiosity: interfaces, systems, React, agents, LLMs, and RAG tools that feel good to use.",
  canonicalPath = Astro.url.pathname,
  socialImage = "/og-image.jpg",
  socialImageAlt = "Aaryan Porwal — AI Systems & Web Engineer",
  socialType = "website",
  bodyClass = "bg-body font-sans text-white antialiased",
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? "https://aaryanporwal.com");
const socialImageUrl = new URL(socialImage, Astro.site ?? "https://aaryanporwal.com");

const posts = sortPosts(
  await getCollection("blog", ({ data }) => data.draft !== true),
);

const commands: CommandItem[] = [
  {
    title: "Home",
    href: "/",
    section: "Navigation",
    description: "Back to the top",
  },
  {
    title: "Work",
    href: "/#work",
    section: "Navigation",
    description: "Featured projects",
  },
  {
    title: "Skills",
    href: "/#skills",
    section: "Navigation",
    description: "Tools and technologies",
  },
  {
    title: "Blog",
    href: "/blog/",
    section: "Navigation",
    description: "Writing archive",
  },
  {
    title: "Contact",
    href: "/#contact",
    section: "Navigation",
    description: "Get in touch",
  },
  {
    title: "GitHub",
    href: "https://github.com/aaryanporwal?tab=repositories",
    section: "Social",
    description: "Projects and repositories",
    external: true,
  },
  {
    title: "LinkedIn",
    href: "https://www.linkedin.com/in/aaryan-porwal/",
    section: "Social",
    description: "Professional profile",
    external: true,
  },
  {
    title: "Scrapbook",
    href: "https://scrapbook.hackclub.com/aaryan",
    section: "Social",
    description: "Build notes and updates",
    external: true,
  },
  ...posts.map((post) => ({
    title: post.data.title,
    href: postHref(post),
    section: "Writing" as const,
    description: postSummary(post),
  })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#08080B" />

    <meta property="og:type" content={socialType} />
    <meta property="og:site_name" content="Aaryan Porwal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2496" />
    <meta property="og:image:height" content="1569" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aaryan7476" />
    <meta name="twitter:creator" content="@aaryan7476" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.ico" sizes="any" />
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=general-sans@400,500,600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        const fallback = "default";
        const themes = new Set([
          "default",
          "light",
          "gruvbox",
          "everforest",
          "nature",
          "rose-pine",
        ]);
        const saved = localStorage.getItem("aaryanporwal-theme");
        const theme = saved === "dark" ? fallback : themes.has(saved) ? saved : fallback;
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <PostHog />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (!target.closest("[data-command-switcher-trigger]")) return;

        window.dispatchEvent(new CustomEvent("command-switcher:open"));
      });
    </script>
    <CommandSwitcher client:load commands={commands} />
  </body>
</html>
